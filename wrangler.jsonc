{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novaproxy1405",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "552c1a66-2ed4-452f-82a0-927dc113dd0c","database_name": "nova" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "dae9b646404b4dd69efa255232ef6d27" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
